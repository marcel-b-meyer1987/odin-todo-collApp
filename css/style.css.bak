/* Globale CSS Custom Properties (Light Mode / Standard) */
:root {
    margin: 0;
    padding: 0;
    box-sizing: border-box;

    --primary-color: #ffffff;
    --secondary-color: #f5f5f5;
    --accent-color: #007acc;
    --text-color: #333333;
    --text-muted: #666666;
    --border-color: #dddddd;
    --success-color: #28a745;
    --danger-color: #dc3545;
    --font-size-base: 1rem;
    --spacing-unit: 1em; /* Relative Maßeinheiten laut Design.md */
}

/* Automatischer Dark Mode über das Betriebssystem */
@media (prefers-color-scheme: dark) {
    :root {
        --primary-color: #1e1e1e;
        --secondary-color: #252526;
        --accent-color: #0098ff;
        --text-color: #ffffff;
        --text-muted: #aaaaaa;
        --border-color: #3c3c3c;
    }
}


/* Manueller Dark Mode Override (wird per Klasse auf <body> gesetzt) */
body.dark-theme {
    --primary-color: #1e1e1e;
    --secondary-color: #252526;
    --accent-color: #0098ff;
    --text-color: #ffffff;
    --text-muted: #aaaaaa;
    --border-color: #3c3c3c;
}

.hidden {
    display: none;
}

/* Responsives Ein-Spalten-Layout (Mobile First) */
body {
    font-size: var(--font-size-base);
    background-color: var(--primary-color);
    color: var(--text-color);
    margin: 0;
    font-family: sans-serif;

    min-height: 100vh;
}

#app-root {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto 1fr auto;
    grid-template-areas: 
        "header"
        "main"
        "footer";
}

header {
    grid-area: header;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.app-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-style: italic; 
    font-weight: 900; 
    font-family: Noto Sans; 
    font-size: 2rem; 
    padding: 1rem;
}

.menu-toggle {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-evenly;
    height: 3.6em;
    background: none;
    outline: none;
    border: none;
    padding: 0.5em 1em;
    cursor: pointer;
}

.bar {
    background-color: var(--text-color);
    width: 2.2em;
    height: 0.4em;
}

main {
    grid-area: main;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
}

.search-filter-container {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: var(--spacing-unit) 0;
    width: 90%;
    align-self: center;
}

#search-input {
    font-weight: 500;
    font-size: var(--font-size-base);
    font-family: inherit;
    line-height: normal;
    color: var(--text-color);
    background-color: var(--primary-color);
    border: 3px solid var(--border-color);
    outline: none;
    border-radius: var(--font-size-base);
    padding: 0.5em calc(var(--spacing-unit) * 3) 0.5em var(--spacing-unit);
    width: 100%;
}

.filter-btn {
    position: absolute;
    right: 0;
    /* display: flex;
    align-items: center;
    justify-content: center; */
    font-weight: 500;
    font-size: calc(var(--font-size-base) * 1.5);
    font-family: inherit;
    line-height: normal;
    color: var(--text-color);
    background-color: var(--primary-color);
    border: 3px solid var(--border-color);
    outline: none;
    border-radius: var(--font-size-base);
    cursor: pointer;
}

#path-container {
    background-color: var(--secondary-color);
    padding: 0.5em var(--spacing-unit);
}

.path-node {
    cursor: pointer;
}

.project-node {
    color: var(--accent-color);
    font-weight: bold;
}

.todo-node {
    font-style: italic;
}

.todo-list {
    list-style: none;
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing-unit) * 0.05);
}

.todo-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: calc(var(--spacing-unit) * 0.5) 1em;
}

.todo-item:nth-child(odd) {
    background-color: var(--secondary-color);
}

.todo-item-main {
    padding: calc(var(--spacing-unit) * 0.15) 1em;
    align-self: flex-start;
}

.todo-context-menu {
    /* hidden by default */
    transition: all 300ms ease-in-out;
    display: none;
    flex-direction: column;
    gap: calc(var(--spacing-unit) * 0.25);
    width: max-content;
    justify-self: flex-end;
    margin-right: calc(var(--spacing-unit) * 3);

    /* position: absolute;
    right: calc(var(--spacing-unit) * 3); */
}

.context-menu-hidden {
    opacity: 0; /* set to 1 on show*/
    display: none; /* set to flex on show */

}

.context-menu-visible {
    display: flex; 
    opacity: 1;
}

.todo-context-menu button {
    font-weight: 500;
    font-size: calc(var(--font-size-base) * 0.75);
    font-family: inherit;
    line-height: normal;
    color: var(--text-color);
    background-color: var(--primary-color);
    border: 1.5px solid var(--text-color);
    outline: none;
    border-radius: calc(var(--font-size-base) * 0.25);
    cursor: pointer;
    padding: 0.5em var(--spacing-unit);
}

footer {
    grid-area: footer;

    display: flex;
    align-items: center;
    justify-content: center;
}
